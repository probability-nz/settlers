{
  "name": "settlers-svg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:assets": "node --import tsx src/generate.jsx",
    "validate": "node --import tsx --test tests/export-svg.test.mjs",
    "build": "npm run generate:assets && npm run validate",
    "dev": "node --watch-path=src --import tsx src/generate.jsx"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "opentype.js": "1.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "tsx": "^4.20.0"
  }
}
